* {
  box-sizing: border-box;
}

html {
  line-height: 1.6;
}

body {
  margin: 0;
  font-family: sans-serif;
  background: #212121;
  color: #c9c9c9;
}

h1, h2, h3, h4, h5, h6 {
  color: #fff;
}

a {
  color: #d7e3e8;
  text-decoration: none;
}

a:hover {
  color: #fff;
  transition: color 0.8s;
}

pre {
  overflow: auto;
}

.app-header {
  padding: 2.5em;
  background: #437f99;
  text-align: center;
}

.app-header-avatar {
  max-width: 15rem;
  max-height: 15rem;
  border-radius: 100%;
  border: 0.5rem solid #d7e3e8;
}

.app-container {
  padding: 2.5rem;
}

.app-header-social {
  font-size: 2em;
  color: #fff;
}

.app-header-social a {
  margin: 0 0.1em;
}

.icon {
  display: block-inline;
  width: 1em;
  height: 1em;
  vertical-align: -0.125em;
}

.tag {
  background: rgba(255, 255, 255, 0.1);
  margin: 0 0.2em;
  padding: 0.2em 0.4em;
  border-radius: 0.2em;
  transition: background 0.8s;
}

.tag:hover {
  background: rgba(255, 255, 255, 0.3);
}

.post-title {
  color: #fff;
}

.post-content pre {
  border-left: 0.4em solid rgba(215, 227, 232, 0.8);
  padding-left: 1em;
}

.post-meta {
  font-size: 0.8em;
}

.posts-list {
  padding: 0;
}

.posts-list-item {
  list-style: none;
  border-bottom: 1px dashed rgba(255, 255, 255, 0.3);
  padding: 0.4em 0;
}

.posts-list-item-description {
  display: block;
  font-size: 0.8em;
}

@media (min-width: 940px) {
  .app-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 20rem;
    min-height: 100vh;
  }

  .app-container {
    max-width: 65rem;
    margin-left: 20rem;
  }
}